# NestJS server configuration
PORT=3001
NODE_ENV=development

# Supabase server-side configuration; never expose the service role key to the browser.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=REPLACE_ME

# Set once authentication design is implemented. Keep the value private.
APP_AUTH_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
